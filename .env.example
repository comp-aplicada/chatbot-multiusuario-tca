# Copie para .env e preencha LLM_API_KEY. Nunca versione o .env.
# Variáveis da seção 7.1 do PRD.

# Provedor do LLM (API compatível com a OpenAI)
# Groq (desenvolvimento, gratuito):
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
# Desliga o raciocínio (modo instruct) no Groq
LLM_EXTRA_BODY={"reasoning_effort":"none"}

# DeepInfra (produção na demo, pago): descomente e comente o bloco do Groq
# LLM_BASE_URL=https://api.deepinfra.com/v1/openai
# LLM_MODEL=Qwen/Qwen3-32B
# LLM_EXTRA_BODY={}

# Timeouts e retries
LLM_TIMEOUT_S=20
LLM_TOTAL_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# Geração
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7

# Sessões
SESSION_TTL_MIN=30
SESSION_MAX=1000
HISTORY_WINDOW=20
MESSAGE_MAX_CHARS=2000
